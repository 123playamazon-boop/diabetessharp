# Chave API Keepa (plano pago — https://keepa.com/#!api )
KEEPA_API_KEY=

# Domínio Keepa: 1 = Amazon.com (EUA)
KEEPA_DOMAIN=1

# Filtros de negócio (podes alterar no .env)
MIN_MONTHLY_SOLD=100
MIN_NEW_OFFERS_TOTAL=4
EXCLUDE_AMAZON_BUYBOX=1

# Pedido à API: ofertas (gasta mais tokens; necessário para buy box seller e contagens fiáveis)
KEEPA_OFFERS=20
